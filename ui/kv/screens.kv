#:kivy 2.1.0

<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"
        padding: "16dp"
        spacing: "12dp"
        MDLabel:
            text: "Choose a database source"
            halign: "center"
            role: "large"
        MDButton:
            style: "filled"
            size_hint: 1, None
            height: "48dp"
            on_release: root.open_file_manager()
            MDButtonText:
                text: "Open local DB"
        MDButton:
            style: "outlined"
            size_hint: 1, None
            height: "48dp"
            on_release: root.open_remote_dialog()
            MDButtonText:
                text: "Connect to remote DB"

<LoadingScreen>:
    BoxLayout:
        orientation: 'vertical'
        MDLabel:
            text: 'Loading...'
        ProgressBar:
            id: progress_bar
            value: 0
            min: 0
            max: 100
            pos_hint: {'x': .1}
            size_hint_x: .8

<DatabaseScreen>:
    id: database_screen

    FloatLayout:
        MDBoxLayout:
            # Main layout
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            MDBoxLayout:
                # Header
                id: ds_header
                md_bg_color: 0.502, 0.337, 0.702, 1 # TODO add flexible color support
                size_hint: 1, .3

                MDLabel:
                    padding: "15dp"
                    text: root.db_label

            RecycleView:
                id: ds_table_list
                viewclass: 'TableItem'
                data: root.table_items
                size_hint_y: 1
                RecycleBoxLayout:
                    default_size: None, dp(56)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    
                    
            MDBoxLayout:
                # Bottom
                adaptive_height: True
                padding: dp(10), dp(10)

                MDCard:
                    # Search Bar
                    # TODO Search function for table name in list on the screen and filter the list accordingly
                    id: ds_searchbar
                    size_hint: 1, None
                    height: "64dp"
                    padding: "10dp"
                    spacing: "12dp"
                    radius: [50, 50, 50, 50]
                    md_bg_color: 0.953, 0.929, 0.969, 1
                    elevation: 1

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: "12dp"

                        MDIconButton:
                            # Search icon
                            size_hint_y: 1
                            size_hint_x: None
                            width: dp(40)
                            icon: "magnify"

                        MDLabel:
                            size_hint_y: 1
                            text: "Search"


                        FloatLayout:
                            MDFabButton:
                                id: fab_menu
                                icon: "dots-vertical"
                                pos_hint: {'right': 1, 'y': 0}
                                size_hint: None, None
                                on_release: root.toggle_fab_menu()                            

                            MDFabButton:
                                id: fab_save_btn
                                size_hint: None, None
                                size: dp(56), dp(56)
                                opacity: 0
                                disabled: True
                                theme_bg_color: "Custom"
                                md_bg_color: 0.502, 0.337, 0.702, 1
                                icon: "content-save"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1
                                on_release: root.action_save()

                            MDFabButton:
                                id: fab_new_table_btn
                                size_hint: None, None
                                size: dp(56), dp(56)
                                opacity: 0
                                disabled: True
                                theme_bg_color: "Custom"
                                md_bg_color: 0.502, 0.337, 0.702, 1
                                icon: "plus"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1
                                on_release: root.action_new_table()

                            MDFabButton:
                                id: fab_edit_btn
                                size_hint: None, None
                                size: dp(56), dp(56)
                                opacity: 0
                                disabled: True
                                theme_bg_color: "Custom"
                                md_bg_color: 0.502, 0.337, 0.702, 1
                                icon: "home"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1
                                on_release: root.action_home()


<TableScreen>:
    id: table_screen
    MDBoxLayout:
        id: table_box_layout
        GridLayout:
            id: table_grid_layout
            size_hint: .8, 1
            cols: 3
        FloatLayout:
            size_hint: .2, 1
            MDIconButton:
                size_hint: .9, .1
                pos_hint: {'top': 0.3, 'right': 1}
                icon: 'delete'
                icon_size: '40sp'
                on_press: app.show_confirmation_dialog()
            MDIconButton:
                size_hint: .9, .1
                pos_hint: {'top': 0.2, 'right': 1}
                icon: 'content-save'
                icon_size: '40sp'
                on_press:
                    root.pressed_button()
                    Factory.SavePopup().open()
            MDIconButton:
                size_hint: .9, .1
                pos_hint: {'top': 0.1, 'right': 1}
                icon: 'arrow-left'
                icon_size: '40sp'
                on_press:
                    root.manager.transition.direction = 'right'
                    root.manager.current = 'database'
