#:kivy 2.1.0
#:import Factory kivy.factory.Factory
#:import MDDialog kivymd.uix.dialog
#:import dp kivy.metrics.dp

<ConnectForm>:
    orientation: "vertical"
    spacing: "8dp"
    padding: "8dp"
    size_hint_y: None
    height: self.minimum_height

    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_y: None
        height: self.minimum_height
        MDLabel:
            text: "Engine"
            size_hint_y: None
            height: self.texture_size[1]
            role: "small"
            theme_text_color: "Hint"
        MDButton:
            id: engine_btn
            style: "outlined"
            size_hint_y: None
            height: "40dp"
            on_release: root.open_menu()
            MDButtonText:
                id: engine_btn_text
                text: root.engine

    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_y: None
        height: self.minimum_height
        MDLabel:
            text: "Host"
            size_hint_y: None
            height: self.texture_size[1]
            role: "small"
            theme_text_color: "Hint"
        MDTextField:
            size_hint_y: None
            height: "56dp"
            id: host
            hint_text: "Hostname or IP"
            text: "localhost"
            helper_text: "Example: localhost or db.mycompany.com"
            helper_text_mode: "on_focus"

    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_y: None
        height: self.minimum_height
        MDLabel:
            text: "Port"
            size_hint_y: None
            height: self.texture_size[1]
            role: "small"
            theme_text_color: "Hint"
        MDTextField:
            size_hint_y: None
            height: "56dp"
            id: port
            hint_text: "Port"
            text: "3306"
            helper_text: "Default: MySQL 3306 / Postgres 5432 / MSSQL 1433"
            helper_text_mode: "on_focus"
            input_filter: "int"

    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_y: None
        height: self.minimum_height
        MDLabel:
            text: "Database"
            size_hint_y: None
            height: self.texture_size[1]
            role: "small"
            theme_text_color: "Hint"
        MDTextField:
            size_hint_y: None
            height: "56dp"
            id: database
            hint_text: "Database / schema name"
            helper_text: "The DB that stores your data"
            helper_text_mode: "on_focus"

    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_y: None
        height: self.minimum_height
        MDLabel:
            text: "User"
            size_hint_y: None
            height: self.texture_size[1]
            role: "small"
            theme_text_color: "Hint"
        MDTextField:
            size_hint_y: None
            height: "56dp"
            id: user
            hint_text: "Username"
            helper_text: "Database account used for the connection"
            helper_text_mode: "on_focus"

    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_y: None
        height: self.minimum_height
        MDLabel:
            text: "Password"
            size_hint_y: None
            height: self.texture_size[1]
            role: "small"
            theme_text_color: "Hint"
        MDTextField:
            size_hint_y: None
            height: "56dp"
            id: password
            hint_text: "Password (optional)"
            helper_text: "Leave blank for passwordless accounts"
            helper_text_mode: "on_focus"
            password: True

    MDBoxLayout:
        size_hint_y: None
        height: "36dp"
        spacing: "8dp"
        MDLabel:
            text: "Use SSL"
            halign: "left"
        MDSwitch:
            id: ssl
            active: False

<SearchBar>:
    id: search_bar
    size_hint_x: 1
    size_hint_y: None
    height: "56dp"
    radius: [50,]
    md_bg_color: (243/255), (237/255), (247/255), 1
    padding: "8dp"
    spacing: "8dp"

    MDBoxLayout:
        orientation: "horizontal"
        spacing: "8dp"

        MDIconButton:
            icon: "magnify"
            on_release: root.do_search(search_input.text)

        MDTextField:
            id: search_input
            mode: "filled"
            multiline: False            

            fill_color_normal: 0, 0, 0, 0
            fill_color_focus: 0, 0, 0, 0
            line_color_normal: 0, 0, 0, 0
            line_color_focus: 0, 0, 0, 0

            size_hint_y: None
            height: "40dp"
            pos_hint: {"center_y": 0.5}

            on_text_validate: root.do_search(self.text)

            MDTextFieldHintText: 
                text: root.hint_text            

        MDIconButton:
            id: menu_btn
            icon: "dots-vertical"
            on_release: root.open_search_menu()


<TableEditorForm>: # TODO
    MDBoxLayout:
        # Header
        id: tef_header
        md_bg_color: 0.502, 0.337, 0.702, 1 # TODO add flexible color support
        size_hint: 1, .3

        MDLabel:
            text: "Hello" #root.db_label

        MDButton:
            #on_release: root.close
            MDIconButton:
                padding: "15dp"
                icon: "close-box"

    MDBoxLayout:
        # Body
        MDTextField:
            mode: "filled"
            MDTextFieldHintText:
                text: "Table name"
        RecycleView:
            viewclass: 'ColumnField'
            RecycleBoxLayout:
                default_size: None, dp(56)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

                MDButton:
                    pos_hint: .5, .5
                    MDIconButton:
                        icon: "plus"


<ColumnField@MDBoxLayout>:
    MDTextField:
        mode: "outlined"

        MDTextFieldHintText:
            text: "Column name"

    MDTextField:
        mode: "outlined"

        MDTextFieldHintText:
            text: "Column type"

    MDBoxLayout:
        orientation: "vertical"

        MDLabel:
            text: "PK"
        MDCheckbox:
    


<TableItem>:
    table_name: ""
    MDButton:
        theme_width: "Custom"
        size_hint: 1, None
        padding: 0, 0
        on_release: root.on_open()
        MDButtonText:
            pos_hint: {'center_y': .5}
            halign: "left"
            text: root.table_name
    MDButton:
        # TODO implement delete functionality
        on_release: root.do_delete_table(None)
        MDButtonIcon:
            pos_hint: {'center_x': .5, 'center_y': .5}
            icon: "trash-can-outline"
    MDButton:
        # TODO implement edit functionality
        on_release: root.do_edit_table(None)
        MDButtonIcon:
            pos_hint: {'center_x': .5, 'center_y': .5}
            icon: "pencil"

<Content>
    orientation: "vertical"
    spacing: "12dp"
    size_hint_y: None
    height: "40dp"

    MDTextField:
        id: delete_ti
        hint_text: 'Enter row ID'
        on_text_validate:
            Factory.TableScreen().delete_row(self.text)
            app.dialog.dismiss()
        multiline: False
